{
  "name": "bifrost/api",
  "description": "Bifrost API micro-framework core",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Bifrost\\\\": "./"
    }
  },
  "scripts": {
    "quality:composer": "composer validate --strict",
    "test": "phpunit -c phpunit.xml",
    "check": [
      "@quality:composer",
      "@test"
    ]
  },
  "suggest": {
    "aws/aws-sdk-php": "S3 integration via Bifrost\\\\Integration\\\\S3Storage",
    "ext-mongodb": "MongoDB log driver via Bifrost\\\\Integration\\\\Database\\\\MongoDatabase"
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  }
}
