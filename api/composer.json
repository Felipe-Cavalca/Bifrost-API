{
  "name": "bifrost/api",
  "description": "Bifrost API micro-framework core",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Bifrost\\": "./"
    },
    "classmap": [
      "Controller/index.php",
      "DataTypes/base64.php",
      "DataTypes/filePath.php",
      "DataTypes/url.php",
      "Interface/PdoDriverAdapter.php"
    ]
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "format:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
    "lint": "find . -path ./vendor -prune -o -path ./tmp -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
    "quality:composer": "composer validate --strict",
    "test": "phpunit -c phpunit.xml",
    "check": [
      "@quality:composer",
      "@format:check",
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "suggest": {
    "aws/aws-sdk-php": "S3 integration via Bifrost\\\\Integration\\\\Storage\\\\S3Storage or the compatibility alias Bifrost\\\\Integration\\\\S3Storage",
    "ext-mongodb": "MongoDB log driver via Bifrost\\\\Integration\\\\Database\\\\MongoDatabase"
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "aws/aws-sdk-php": "^3.381",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  }
}
