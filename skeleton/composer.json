{
    "name": "bifrost/skeleton",
    "description": "Projeto base para APIs construidas com o Bifrost Framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bifrost/framework": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml"
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
