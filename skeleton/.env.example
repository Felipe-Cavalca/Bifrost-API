APP_DEBUG=false
APP_PORT=8080

# Preencha ao instalar um unico cache: bifrost/cache-apcu ou bifrost/cache-redis.
# CACHE_DRIVER=apcu
# CACHE_DRIVER=redis
# CACHE_PREFIX=bifrost:cache:
# CACHE_TTL=60

# Preencha ao instalar bifrost/cache-redis ou bifrost/queue-redis.
# REDIS_HOST=redis
# REDIS_PORT=6379
# QUEUE_PREFIX=bifrost:queue:

# Preencha ao instalar um unico pacote de banco:
# DB_DRIVER=mysql
# DB_DRIVER=postgresql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=app
# DB_USERNAME=app
# DB_PASSWORD=app

# Preencha ao instalar um unico pacote de log:
# LOG_DRIVER=stdout
# LOG_DRIVER=file
# LOG_DRIVER=mongodb
# LOG_STREAM=stdout
# LOG_FILE=storage/logs/app.log
# MONGO_LOG_URI=mongodb://mongo:27017
# MONGO_LOG_HOST=mongo
# MONGO_LOG_PORT=27017
# MONGO_LOG_DATABASE=bifrost_logs
# MONGO_LOG_COLLECTION=logs
# MONGO_LOG_USERNAME=
# MONGO_LOG_PASSWORD=
