{
  "name": "bifrost/storage-s3",
  "description": "Armazenamento S3 opcional para o Bifrost Framework",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "aws/aws-sdk-php": "^3.381",
    "bifrost/framework": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Bifrost\\Extension\\StorageS3\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
