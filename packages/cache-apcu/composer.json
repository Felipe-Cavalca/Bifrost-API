{
  "name": "bifrost/cache-apcu",
  "description": "Adapter APCu opcional para cache no Bifrost Framework",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "bifrost/framework": "^1.0",
    "ext-apcu": "*"
  },
  "autoload": {
    "psr-4": {
      "Bifrost\\Extension\\CacheApcu\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "test": "@php -d apc.enable_cli=1 vendor/bin/phpunit -c phpunit.xml"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
