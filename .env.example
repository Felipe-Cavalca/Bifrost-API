# Bifrost Framework - ambiente de projeto novo
#
# Copie para .env apenas no projeto consumidor. Nao commite credenciais reais.
# O runtime legado em api/ ainda possui variaveis BFR_API_* proprias; este
# arquivo documenta o novo backend Composer/skeleton dentro de api/.

APP_NAME=Bifrost
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# HTTP
HTTP_PORT=8080

# Cache: none, apcu ou redis
CACHE_DRIVER=none
CACHE_TTL=3600

# Redis: usado por cache-redis e queue-redis quando instalados
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# Queue: sync ou redis
QUEUE_DRIVER=sync
QUEUE_NAME=bifrost_queue

# Database: none, mysql ou postgresql
DB_DRIVER=none
DB_HOST=database
DB_PORT=5432
DB_NAME=bifrost
DB_USER=bifrost
DB_PASSWORD=

# Storage: local ou s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage
S3_BUCKET=
S3_REGION=us-east-1
S3_KEY=
S3_SECRET=
S3_ENDPOINT=
S3_PATH_STYLE=false

# Logging: error_log, file ou mongodb
LOG_DRIVER=error_log
LOG_FILE=/app/storage/logs/bifrost.log
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=bifrost_logs
MONGO_COLLECTION=logs
